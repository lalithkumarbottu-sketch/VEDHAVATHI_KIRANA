@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');
:root{--green:#18794e;--dark:#105c39;--light:#eaf5ed;--yellow:#f8c944;--ink:#1f2d25;--muted:#6b786f;--white:#fff;--line:#e5ece7;--shadow:0 14px 35px rgba(23,66,43,.09)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Poppins, sans-serif;color:var(--ink);background:#fff;line-height:1.6}a{color:inherit;text-decoration:none}button,input,select{font:inherit}.container{width:min(1160px,calc(100% - 40px));margin:auto}.header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}.nav-container{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}.logo{display:flex;align-items:center;gap:12px}.logo-icon{width:44px;height:44px;border-radius:13px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:24px;font-weight:800}.logo strong,.logo small{display:block;line-height:1.25}.logo strong{letter-spacing:1.5px}.logo small{font-size:10px;color:var(--muted);letter-spacing:1px}.header-right{display:flex;align-items:center;gap:16px}.header-phone{font-weight:600;font-size:14px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 20px;border-radius:9px;font-weight:600;border:1px solid transparent;cursor:pointer;transition:.2s}.btn-green{background:var(--green);color:#fff}.btn-green:hover{background:var(--dark);transform:translateY(-1px)}.btn-outline{border-color:var(--green);color:var(--green);background:#fff}.btn-outline:hover{background:var(--light)}.btn-full{width:100%}.hero{background:linear-gradient(120deg,#f1f8f1,#fff 65%);padding:78px 0}.hero-content{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:55px}.eyebrow{color:var(--green);font-size:11px;font-weight:700;letter-spacing:1.7px}.hero h1{font-size:clamp(38px,5vw,58px);line-height:1.15;margin:14px 0}.hero h1 span{display:block;color:var(--green)}.hero-text>p{max-width:570px;color:var(--muted)}.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin:25px 0}.hero-trust{display:flex;gap:20px;flex-wrap:wrap;color:#557061;font-size:12px;font-weight:600}.hero-visual{min-height:300px;display:grid;place-items:center;position:relative}.hero-circle{position:absolute;width:280px;height:280px;border-radius:50%;background:#dcefe0}.hero-card{z-index:1;background:#fff;border:1px solid #e7eee8;border-radius:22px;padding:35px;text-align:center;box-shadow:var(--shadow);width:min(330px,100%)}.hero-emoji{font-size:58px}.hero-card h3{margin:8px 0}.hero-card p{color:var(--muted);font-size:13px}.hero-tags{display:flex;justify-content:center;gap:7px;flex-wrap:wrap}.hero-tags span{background:var(--light);padding:5px 10px;border-radius:30px;font-size:11px}.section{padding:76px 0}.section-heading{text-align:center;margin:0 auto 34px;max-width:650px}.section-heading h2,.about-content h2{font-size:clamp(27px,3vw,36px);line-height:1.25;margin:8px 0}.section-heading p{color:var(--muted);margin:8px 0}.categories-section{background:#fff}.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.category-card{border:1px solid var(--line);background:#fff;border-radius:13px;padding:19px;text-align:left;display:grid;grid-template-columns:48px 1fr;column-gap:12px;cursor:pointer;transition:.2s}.category-card:hover,.category-card.active{border-color:var(--green);background:var(--light);transform:translateY(-2px)}.category-icon{grid-row:span 2;font-size:28px;align-self:center}.category-card strong{font-size:14px}.category-card small{color:var(--muted)}.catalogue-section{background:#f8fbf8}.catalogue-toolbar{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px}.catalogue-toolbar input,.catalogue-toolbar select,.cart-form input,.cart-form select{width:100%;padding:13px 14px;border:1px solid #dce6df;border-radius:9px;background:#fff;outline:none}.catalogue-toolbar input:focus,.catalogue-toolbar select:focus,.cart-form input:focus{border-color:var(--green)}.catalogue-info{display:flex;justify-content:space-between;align-items:center;margin:16px 0;color:var(--muted);font-size:13px}.text-button{border:0;background:none;color:var(--green);font-weight:600;cursor:pointer}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.product-card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,.03)}.product-image{height:130px;background:var(--product-color);display:grid;place-items:center}.product-image span{font-size:48px}.product-info{padding:15px}.product-brand{font-size:10px;color:var(--green);font-weight:700;letter-spacing:1px;text-transform:uppercase}.product-info h3{font-size:15px;margin:5px 0}.product-size,.product-price{font-size:12px;color:var(--muted);margin:4px 0}.product-price{font-weight:700;color:var(--ink)}.bulk-note{font-size:10px;color:var(--green);margin:7px 0}.product-actions{display:flex;gap:7px;margin-top:12px}.product-qty{width:58px;border:1px solid var(--line);border-radius:7px;padding:8px}.add-button{flex:1;border:0;border-radius:7px;background:var(--green);color:#fff;font-size:12px;font-weight:600;cursor:pointer;padding:9px}.add-button:disabled{background:#aab6ae;cursor:not-allowed}.stock-out{display:inline-block;color:#a33;background:#fff0ed;border-radius:5px;padding:4px 8px;font-size:11px;margin-top:5px}.load-more-container{text-align:center;margin-top:28px}.no-products,.loading{grid-column:1/-1;padding:30px;text-align:center;color:var(--muted)}.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.why-card{padding:23px;border:1px solid var(--line);border-radius:13px;text-align:center}.why-card>span{font-size:30px}.why-card h3{font-size:15px}.why-card p{font-size:12px;color:var(--muted)}.contact-section{background:#f8fbf8}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.contact-details,.map-container{background:#fff;border:1px solid var(--line);border-radius:15px;padding:25px}.contact-item{display:flex;gap:14px;margin-bottom:18px}.contact-item>span{font-size:23px}.contact-item h3{font-size:14px;margin:0}.contact-item p{font-size:13px;color:var(--muted);margin:3px 0}.contact-actions{display:flex;gap:10px;flex-wrap:wrap}.map-placeholder{height:100%;min-height:280px;display:grid;align-content:center;justify-items:center;background:var(--light);border-radius:10px;text-align:center;padding:20px}.map-placeholder span{font-size:42px}.map-placeholder p{color:var(--muted);font-size:13px}.footer{background:#123c2a;color:#fff;padding:30px 0}.footer-content{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}.footer h3{margin:0;letter-spacing:2px}.footer p{font-size:12px;color:#c4d7cb}.footer-links{display:flex;gap:17px;font-size:12px}.cart-button{position:fixed;right:22px;bottom:22px;z-index:30;border:0;border-radius:50px;background:var(--dark);color:#fff;padding:13px 18px;box-shadow:var(--shadow);display:flex;align-items:center;gap:9px;font-weight:600;cursor:pointer}.cart-count{background:var(--yellow);color:#333;border-radius:50%;min-width:22px;height:22px;display:grid;place-items:center;font-size:11px}.cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,.38);z-index:39;opacity:0;visibility:hidden;transition:.25s}.cart-overlay.open{opacity:1;visibility:visible}.cart-panel{position:fixed;right:0;top:0;height:100dvh;width:min(440px,100%);background:#fff;z-index:40;transform:translateX(105%);transition:.28s;display:flex;flex-direction:column;padding:22px;box-shadow:-12px 0 35px rgba(0,0,0,.12)}.cart-panel.open{transform:translateX(0)}.cart-header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:15px}.cart-header h2{margin:2px 0}.close-button{border:0;background:#f0f4f1;border-radius:50%;width:36px;height:36px;cursor:pointer}.cart-items{overflow:auto;flex:1;padding:12px 0}.empty-cart{color:var(--muted);font-size:13px;text-align:center;padding:35px 10px}.cart-item{display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid var(--line);padding:12px 0}.cart-item h4{margin:0;font-size:13px}.cart-item p{margin:3px 0;color:var(--muted);font-size:11px}.cart-item-actions{display:flex;align-items:center;gap:7px}.cart-item-actions button{border:1px solid var(--line);background:#fff;border-radius:6px;width:27px;height:27px;cursor:pointer}.cart-form{border-top:1px solid var(--line);padding-top:15px;display:grid;gap:8px}.cart-form label{font-size:12px;font-weight:600}.cart-form input,.cart-form select{padding:10px}.form-note{font-size:10px;color:var(--muted);margin:0}.offers-banner{background:var(--yellow);text-align:center;padding:9px 15px;font-size:13px;font-weight:700;color:#453500}.buyer-choice{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding-top:16px;padding-bottom:5px;font-size:12px}.buyer-choice>span{font-weight:700}.buyer-choice-btn{border:1px solid #cddbd1;background:#fff;border-radius:30px;padding:7px 13px;font-size:11px;cursor:pointer}.buyer-choice-btn.active{background:var(--green);border-color:var(--green);color:#fff}.buyer-choice small{color:var(--muted);margin-left:auto}.rate-section{background:#f8fbf8}.rate-updated{text-align:right;color:var(--muted);font-size:11px}.table-wrap{overflow:auto;background:#fff;border:1px solid var(--line);border-radius:12px}.rate-table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}.rate-table th,.rate-table td{padding:13px 17px;border-bottom:1px solid var(--line)}.rate-table th{background:var(--light);color:var(--dark)}.rate-download{margin-top:18px}.brand-strip-section{padding:45px 0;background:#fff}.compact-heading{margin-bottom:20px}.compact-heading h2{font-size:25px}.brand-strip{display:grid;grid-template-columns:repeat(8,1fr);gap:9px}.brand-strip div{border:1px solid var(--line);border-radius:8px;text-align:center;padding:13px 5px;font-weight:700;font-size:12px;color:#506157}.about-section{background:var(--light)}.about-content{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:40px}.about-content p{color:#52645a}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.gallery-placeholder{min-height:150px;border-radius:12px;background:linear-gradient(135deg,#eaf5ed,#f9f3df);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#557061}.gallery-placeholder span{font-size:36px}.gallery-placeholder strong{font-size:13px}.faq-section{background:#f8fbf8}.faq-container{max-width:850px}.faq-container details{background:#fff;border:1px solid var(--line);border-radius:9px;padding:15px 18px;margin:10px 0}.faq-container summary{font-weight:600;font-size:14px;cursor:pointer}.faq-container details p{font-size:13px;color:var(--muted);margin-bottom:0}.status-pill{font-weight:700;color:#a33}.status-pill.is-open{color:#18794e}.status-pill.is-closed{color:#a33}
@media(max-width:900px){.product-grid{grid-template-columns:repeat(3,1fr)}.why-grid{grid-template-columns:repeat(2,1fr)}.brand-strip{grid-template-columns:repeat(4,1fr)}}@media(max-width:650px){.container{width:min(100% - 28px,1160px)}.nav-container{min-height:68px}.header-right{gap:8px}.header-phone{font-size:11px}.header-right .btn{font-size:10px;padding:9px}.logo-icon{width:38px;height:38px}.logo strong{font-size:13px}.logo small{font-size:8px}.hero{padding:48px 0}.hero-content{grid-template-columns:1fr;gap:20px}.hero-visual{min-height:240px}.hero-circle{width:220px;height:220px}.hero-card{padding:22px}.section{padding:55px 0}.category-grid{grid-template-columns:repeat(2,1fr);gap:9px}.category-card{padding:12px 9px;grid-template-columns:34px 1fr}.category-icon{font-size:22px}.category-card strong{font-size:11px}.category-card small{font-size:9px}.catalogue-toolbar{grid-template-columns:1fr}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.product-image{height:100px}.product-info{padding:11px}.product-info h3{font-size:13px}.product-qty{width:44px}.add-button{font-size:10px;padding:8px 4px}.why-grid{gap:9px}.why-card{padding:14px 9px}.contact-grid,.about-content{grid-template-columns:1fr}.contact-details,.map-container{padding:17px}.footer-content{display:grid;justify-content:center;text-align:center}.footer-links{justify-content:center;flex-wrap:wrap}.cart-button{right:13px;bottom:13px}.buyer-choice{gap:6px}.buyer-choice small{width:100%;margin-left:0}.brand-strip{grid-template-columns:repeat(4,1fr)}.brand-strip div{font-size:10px;padding:10px 3px}.gallery-grid{grid-template-columns:repeat(2,1fr)}.gallery-placeholder{min-height:120px}.rate-table th,.rate-table td{padding:10px;font-size:11px}.rate-updated{text-align:left}}
